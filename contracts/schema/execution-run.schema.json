{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voicepartner.local/contracts/execution-run.schema.json",
  "title": "VoicePartner execution run",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "request_id", "executor_id", "state", "sequence", "created_at", "updated_at", "verification_state", "artifact_refs"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "request_id": { "type": "string", "format": "uuid" },
    "external_id": { "type": ["string", "null"] },
    "executor_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": ["string", "null"] },
    "approved_request_hash": { "type": ["string", "null"] },
    "state": { "enum": ["queued", "awaiting_approval", "running", "succeeded", "failed", "cancellation_requested", "cancelled", "outcome_unknown"] },
    "sequence": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "integer", "minimum": 0 },
    "verification_state": { "type": "string" },
    "artifact_refs": { "type": "array", "items": { "type": "string" } }
  }
}
